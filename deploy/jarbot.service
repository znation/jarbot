[Unit]
Description=Jar! Bluesky bot
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/jarbot
ExecStart=%h/jarbot/.venv/bin/jarbot run
Restart=on-failure
RestartSec=30
# Low CPU priority: the iMac throttles under sustained all-core load.
Nice=10

# Hardening: the bot needs the network, its repo, and nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/jarbot/state %h/jarbot/models
PrivateDevices=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=default.target
