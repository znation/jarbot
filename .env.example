# Copy to .env and fill in. Create the app password at
# Bluesky > Settings > Privacy and security > App passwords (not your main password).
BSKY_HANDLE=jarjarbot.bsky.social
BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Model (downloaded from Hugging Face on first use into ./models)
#JAR_MODEL_REPO=unsloth/Qwen3-4B-Instruct-2507-GGUF
#JAR_MODEL_FILE=Qwen3-4B-Instruct-2507-Q4_K_M.gguf
#JAR_MODEL_PATH=/path/to/any.gguf   # overrides the two above
#JAR_THREADS=6                      # CPU threads for llama.cpp
#JAR_GPU_LAYERS=0                   # layers to offload to the GPU (the wheel must be built with CUDA)

# Behaviour
#JAR_POLL_SECONDS=20
#JAR_MAX_AGE_HOURS=6                # ignore mentions older than this
#JAR_MAX_PER_AUTHOR_PER_HOUR=10
#JAR_MAX_PER_HOUR=60
#JAR_MAX_REPLIES_PER_THREAD=10      # stop answering in one thread after this many
#JAR_REPLY_TO_BOTS=0                # 1 lets Jar! answer bot-labelled accounts (loop risk)
#JAR_STATE_DIR=state
